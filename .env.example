# --- Required ---

# Postgres connection string
DATABASE_URL=postgres://webshop:webshop@localhost:5432/webshop

# Secret used to encrypt payment credentials at rest and sign order links.
# Generate one with: openssl rand -base64 32
APP_SECRET=change-me-to-a-long-random-string

# Public base URL of this shop (no trailing slash).
# Used for payment redirects, webhook URLs and email links.
APP_URL=http://localhost:3000

# --- Optional ---

# Directory for uploaded product images and deliverable files (default: ./data)
# DATA_DIR=./data

# Compose-only overrides
# POSTGRES_USER=webshop
# POSTGRES_PASSWORD=webshop
# POSTGRES_DB=webshop
# POSTGRES_PORT=5432
